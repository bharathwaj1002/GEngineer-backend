# Copy this file to .env and adjust as needed for local development.
# These are development-only defaults — never use them in production.

DATABASE_URL="postgresql://gengineer:gengineer@localhost:5432/gengineer?schema=public"

# CORS: the origin(s) the frontend dev server runs on
# Comma-separated list — Vite auto-increments the port (5174, 5175, ...) if 5173 is taken.
CORS_ORIGIN="http://localhost:5173,http://localhost:5174"

PORT=4000

# JWT secrets — generate real random secrets for anything beyond local dev
JWT_ACCESS_SECRET="dev-access-secret-change-me"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_SECRET="dev-refresh-secret-change-me"
JWT_REFRESH_TTL="7d"

# Seed script development accounts (never use these passwords in production)
SEED_ADMIN_EMAIL="admin@gengineer.dev"
SEED_ADMIN_PASSWORD="ChangeMe123!"
SEED_CANDIDATE_PASSWORD="ChangeMe123!"
